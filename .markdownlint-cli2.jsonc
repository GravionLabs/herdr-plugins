{
  // Markdown style for the repo's documents (README files, docs/, ADRs, issue templates).
  // Generated and dependency folders are ignored.
  "globs": ["**/*.md"],
  "ignores": [
    "node_modules/**",
    "apps/site/.vitepress/cache/**",
    "apps/site/.vitepress/dist/**",
    "dist/**",
    // Generated by git-cliff (npm run changelog, cliff.toml); a hand edit is overwritten on the next release.
    "CHANGELOG.md",
    "git-cliff/CHANGELOG.md"
  ],
  "config": {
    "default": true,
    // Long lines: tables, links and prose are often wide; wrapping them hurts diffs.
    "MD013": false,
    // Table pipe spacing: the compact "|a|b|" style is used throughout; re-padding every table is churn without value.
    "MD060": false,
    // Inline HTML: VitePress components, <kbd> and <details> in docs are intentional.
    "MD033": false,
    // First line need not be a top-level heading: VitePress pages start with YAML frontmatter.
    "MD041": false,
    // Bare URLs are common in plain-text references; links are checked by lychee.
    "MD034": false,
    // Same heading text under different parents (e.g. "Usage" per plugin) is normal here.
    "MD024": { "siblings_only": true },
    // Code fences without a language are allowed for command transcripts and tree listings.
    "MD040": false
  }
}
